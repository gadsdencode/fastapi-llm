    if x_api_key is None:
        raise HTTPException(
            status_code=401,
            detail="API key required. Please provide x-api-key header."
        )
    
    if x_api_key != API_KEY:
        raise HTTPException(
            status_code=401,
            detail="Invalid API key"
        )
    
    return True


